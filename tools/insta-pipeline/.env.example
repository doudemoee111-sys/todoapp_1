# ===== 必須（あなたが取得済みのキー）=====
OPENAI_API_KEY=sk-...
STABILITY_API_KEY=sk-...
GOOGLE_TTS_API_KEY=AIza...

# ===== 任意：モデル指定 =====
OPENAI_MODEL=gpt-4o
# 画像モデル: core（安価・高速） / ultra（高品質） / sd3.5-large
STABILITY_MODEL=core
# 音声: https://cloud.google.com/text-to-speech/docs/voices
GOOGLE_TTS_VOICE=ja-JP-Neural2-B
GOOGLE_TTS_RATE=1.05

# ===== 自動投稿する場合のみ（Meta開発者アプリから無料取得）=====
# 取得手順は README の「Instagram Graph API トークンの取り方」参照
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v21.0

# 動画/画像の公開URLベース（Graph APIは公開URLしか受け付けない）
# 例: https://your-bucket.s3.ap-northeast-1.amazonaws.com/insta
PUBLIC_ASSET_BASE_URL=
