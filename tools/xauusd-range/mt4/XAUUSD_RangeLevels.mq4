//+------------------------------------------------------------------+
//|  XAUUSD_RangeLevels.mq4                                          |
//|                                                                  |
//|  Draws the daily XAU/USD range forecast as horizontal lines with  |
//|  price labels. It fetches a level feed over HTTPS and redraws on  |
//|  a timer.                                                        |
//|                                                                  |
//|  THIS EXPERT ADVISOR PLACES NO ORDERS. It contains no call to     |
//|  OrderSend, OrderClose or OrderModify. It only draws objects.     |
//|                                                                  |
//|  It is an Expert Advisor and not an indicator because MQL4 does   |
//|  not allow WebRequest() from a custom indicator.                  |
//|                                                                  |
//|  Setup                                                           |
//|    1. Copy to MQL4\Experts\ and compile (F7) in MetaEditor.        |
//|    2. Tools > Options > Expert Advisors:                          |
//|         tick "Allow WebRequest for listed URL"                    |
//|         add  https://raw.githubusercontent.com                    |
//|    3. Tick "Allow automated trading" (needed to run an EA at all; |
//|       this one still places no orders).                           |
//|    4. Attach to an XAUUSD chart.                                  |
//|                                                                  |
//|  The feed carries two sets of numbers, because the daily bar      |
//|  boundary follows the broker's server clock:                      |
//|    nyclose  server GMT+2/+3 with US DST (Axiory and most brokers) |
//|    utc      server GMT+0 fixed            (Exness)                |
//|  The high and low of the same calendar day differ between them,   |
//|  so the EA picks a set from the server's own GMT offset.          |
//+------------------------------------------------------------------+
#property copyright "Generated by Claude Code"
#property link      "https://claude.ai/code"
#property version   "1.00"
#property strict

enum ENUM_CONV_MODE
  {
   CONV_AUTO = 0,  // Auto (detect from server GMT offset)
   CONV_NYCLOSE,   // Force nyclose (server GMT+2/+3, e.g. Axiory)
   CONV_UTC        // Force utc (server GMT+0, e.g. Exness)
  };

input string InpFeedURL          = "https://raw.githubusercontent.com/doudemoee111-sys/todoapp_1/refs/heads/claude/funny-mayer-vcwsjx/tools/xauusd-range/mt4/latest.txt"; // Feed URL
input ENUM_CONV_MODE InpConv     = CONV_AUTO;  // Which number set to use
input int    InpRefreshMinutes   = 15;         // Refresh every N minutes
input int    InpTimeoutMs        = 5000;       // HTTP timeout (ms)

input string _s1 = "--- which lines ---";      // ---
input bool   InpShowBox50        = true;       // Forecast box 50%
input bool   InpShowBox70        = false;      // Forecast box 70%
input bool   InpShowBox80        = true;       // Forecast box 80%
input bool   InpShowBox90        = false;      // Forecast box 90%
input bool   InpShowCond80       = true;       // Conditional box 80% (rest of session)
input bool   InpShowCond50       = false;      // Conditional box 50% (rest of session)
input bool   InpShowPrevHL       = true;       // Previous session high / low
input bool   InpShowPrevClose    = true;       // Previous session close
input bool   InpShowPivot        = true;       // Pivot, R1, S1
input bool   InpShowPivotOuter   = false;      // R2, R3, S2, S3
input bool   InpShowSwing        = false;      // 20-day high / low

input string _s2 = "--- appearance ---";       // ---
input color  InpColBox           = clrDodgerBlue;   // Forecast box
input color  InpColCond          = clrMediumOrchid; // Conditional box
input color  InpColPrev          = clrDarkOrange;   // Previous session high/low
input color  InpColClose         = clrGray;         // Previous close
input color  InpColPivot         = clrSeaGreen;     // Pivot / R / S
input color  InpColSwing         = clrSlateGray;    // 20-day high/low
input int    InpLabelShiftBars   = 2;          // Label offset to the right (bars)
input bool   InpShortLabels      = true;       // Short labels (80%H instead of 80% HIGH)
input int    InpLabelColumnBars  = 10;         // Step between label columns (bars)
input int    InpLabelColumns     = 3;          // How many label columns to spread into
input int    InpFontSize         = 8;          // Label font size
input bool   InpShowStatus       = true;       // Show status in the chart comment

#define PREFIX "XRL_"

string g_conv      = "";
string g_status    = "";
string g_info_keys[];
string g_info_vals[];
datetime g_last_ok = 0;

// levels gathered during a parse, drawn after, so labels can be laid out
string g_lv_id[];
string g_lv_label[];
string g_lv_short[];
double g_lv_price[];
color  g_lv_col[];
int    g_lv_style[];
int    g_lv_width[];

//+------------------------------------------------------------------+
int OnInit()
  {
   if(StringFind(Symbol(), "XAU") < 0 && StringFind(Symbol(), "GOLD") < 0
      && StringFind(Symbol(), "Gold") < 0)
      Print("XRL: warning - chart symbol is ", Symbol(),
            ", which does not look like gold. The feed is XAU/USD.");

   g_conv = ResolveConvention();
   Print("XRL: using the \"", g_conv, "\" number set (server GMT offset ",
         ServerGmtOffsetHours(), "h)");

   int mins = InpRefreshMinutes;
   if(mins < 1)
      mins = 1;
   EventSetTimer(mins * 60);
   Refresh();
   return(INIT_SUCCEEDED);
  }

//+------------------------------------------------------------------+
void OnDeinit(const int reason)
  {
   EventKillTimer();
   ObjectsDeleteAll(0, PREFIX, -1, -1);
   Comment("");
  }

//+------------------------------------------------------------------+
void OnTimer()
  {
   Refresh();
  }

//+------------------------------------------------------------------+
void OnTick()
  {
   // Nothing. This EA does not trade; the labels are repositioned only so
   // they stay beside the newest bar.
   static datetime last = 0;
   if(Time[0] != last)
     {
      last = Time[0];
      ShiftLabels();
     }
  }

//+------------------------------------------------------------------+
//| Server clock offset from GMT, in whole hours.                    |
//| TimeGMT() derives GMT from this PC's clock, so a badly set local |
//| clock will mis-detect; override with InpConv if that happens.    |
//+------------------------------------------------------------------+
int ServerGmtOffsetHours()
  {
   double diff = (double)(TimeCurrent() - TimeGMT());
   return((int)MathRound(diff / 3600.0));
  }

//+------------------------------------------------------------------+
string ResolveConvention()
  {
   if(InpConv == CONV_NYCLOSE)
      return("nyclose");
   if(InpConv == CONV_UTC)
      return("utc");
   int off = ServerGmtOffsetHours();
   if(off >= 1)
      return("nyclose");   // GMT+2 winter / GMT+3 summer
   return("utc");          // GMT+0 fixed
  }

//+------------------------------------------------------------------+
void Refresh()
  {
   string body = "";
   if(!Download(body))
     {
      Status();
      return;
     }
   g_conv = ResolveConvention();
   ObjectsDeleteAll(0, PREFIX, -1, -1);
   ArrayResize(g_info_keys, 0);
   ArrayResize(g_info_vals, 0);
   ArrayResize(g_lv_price, 0);
   ArrayResize(g_lv_id, 0);
   ArrayResize(g_lv_label, 0);
   ArrayResize(g_lv_short, 0);
   ArrayResize(g_lv_col, 0);
   ArrayResize(g_lv_style, 0);
   ArrayResize(g_lv_width, 0);
   int drawn = Parse(body);
   g_last_ok = TimeCurrent();
   g_status  = "OK - " + IntegerToString(drawn) + " lines";
   ChartRedraw();
   Status();
  }

//+------------------------------------------------------------------+
bool Download(string &body)
  {
   char   data[], result[];
   string headers = "";
   ArrayResize(data, 0);
   ResetLastError();
   int code = WebRequest("GET", InpFeedURL, "", InpTimeoutMs, data, result, headers);
   if(code == -1)
     {
      int err = GetLastError();
      if(err == 4060)
         g_status = "ERROR 4060 - add https://raw.githubusercontent.com under"
                    " Tools > Options > Expert Advisors > Allow WebRequest for listed URL";
      else
         g_status = "ERROR - WebRequest failed, code " + IntegerToString(err);
      Print("XRL: ", g_status);
      return(false);
     }
   if(code != 200)
     {
      g_status = "ERROR - HTTP " + IntegerToString(code);
      Print("XRL: ", g_status, " for ", InpFeedURL);
      return(false);
     }
   body = CharArrayToString(result, 0, WHOLE_ARRAY, CP_UTF8);
   if(StringLen(body) < 8)
     {
      g_status = "ERROR - empty feed";
      Print("XRL: ", g_status);
      return(false);
     }
   return(true);
  }

//+------------------------------------------------------------------+
int Parse(const string body)
  {
   string lines[];
   int n = StringSplit(body, '\n', lines);
   int drawn = 0;
   for(int i = 0; i < n; i++)
     {
      string line = lines[i];
      StringTrimRight(line);
      StringTrimLeft(line);
      if(StringLen(line) < 4)
         continue;

      string f[];
      int fn = StringSplit(line, '|', f);

      if(fn >= 4 && f[0] == "INFO" && f[1] == g_conv)
        {
         int k = ArraySize(g_info_keys);
         ArrayResize(g_info_keys, k + 1);
         ArrayResize(g_info_vals, k + 1);
         g_info_keys[k] = f[2];
         g_info_vals[k] = f[3];
         continue;
        }

      if(fn >= 6 && f[0] == "LEVEL" && f[1] == g_conv)
        {
         string kind  = f[2];
         int    cov   = (int)StringToInteger(f[3]);
         string label = f[4];
         double price = StringToDouble(f[5]);
         if(price <= 0.0)
            continue;
         color  clr = InpColPivot;
         int    style = STYLE_DOT;
         int    width = 1;
         if(!Wanted(kind, cov, clr, style, width))
            continue;
         Collect(kind + "_" + IntegerToString(cov), label,
                 ShortLabel(kind, cov, label), price, clr, style, width);
        }
     }
   return(DrawCollected());
  }

//+------------------------------------------------------------------+
//| A compact label. The long text is wider than the gap between      |
//| label columns, so two columns still overlap on a crowded chart;   |
//| "C80H 4013.46" fits where "COND 80% HIGH 4013.46" does not.       |
//+------------------------------------------------------------------+
string ShortLabel(const string kind, const int cov, const string label)
  {
   string c = IntegerToString(cov);
   if(kind == "box_high")
      return(c + "%H");
   if(kind == "box_low")
      return(c + "%L");
   if(kind == "cond_high")
      return("C" + c + "H");
   if(kind == "cond_low")
      return("C" + c + "L");
   if(kind == "prev_high")
      return("PH");
   if(kind == "prev_low")
      return("PL");
   if(kind == "prev_close")
      return("PC");
   if(kind == "swing_high")
      return("20DH");
   if(kind == "swing_low")
      return("20DL");
   if(kind == "pivot")
      return(label == "PIVOT" ? "P" : label);
   return(label);
  }

//+------------------------------------------------------------------+
void Collect(const string id, const string label, const string shortLabel,
             const double price, const color clr, const int style, const int width)
  {
   // Pivot rows share one kind, so the inner/outer split is decided here.
   if(StringFind(id, "pivot_") == 0)
     {
      bool inner = (label == "PIVOT" || label == "R1" || label == "S1");
      if(inner && !InpShowPivot)
         return;
      if(!inner && !InpShowPivotOuter)
         return;
     }
   int k = ArraySize(g_lv_price);
   ArrayResize(g_lv_id, k + 1);
   ArrayResize(g_lv_label, k + 1);
   ArrayResize(g_lv_short, k + 1);
   ArrayResize(g_lv_price, k + 1);
   ArrayResize(g_lv_col, k + 1);
   ArrayResize(g_lv_style, k + 1);
   ArrayResize(g_lv_width, k + 1);
   g_lv_id[k] = id;
   g_lv_label[k] = label;
   g_lv_short[k] = shortLabel;
   g_lv_price[k] = price;
   g_lv_col[k] = clr;
   g_lv_style[k] = style;
   g_lv_width[k] = width;
  }

//+------------------------------------------------------------------+
//| Draw highest first, putting each label in a column that is clear  |
//| at that price. MT4 objects do not move out of each other's way,   |
//| and alternating between two columns is not enough: three crowded  |
//| levels in a row put the first and third back in the same column.  |
//| So each column remembers the price of its last label, and a level |
//| takes the first column whose last label is far enough above it.   |
//+------------------------------------------------------------------+
int DrawCollected()
  {
   int n = ArraySize(g_lv_price);
   if(n == 0)
      return(0);

   int idx[];
   ArrayResize(idx, n);
   for(int i = 0; i < n; i++)
      idx[i] = i;
   for(int a = 0; a < n - 1; a++)          // descending by price
      for(int b = a + 1; b < n; b++)
         if(g_lv_price[idx[b]] > g_lv_price[idx[a]])
           {
            int t = idx[a];
            idx[a] = idx[b];
            idx[b] = t;
           }

   double span = g_lv_price[idx[0]] - g_lv_price[idx[n - 1]];
   double gap  = (span > 0.0) ? span * 0.030 : 0.0;

   int ncols = InpLabelColumns;
   if(ncols < 1)
      ncols = 1;
   if(ncols > 6)
      ncols = 6;

   double taken[];                          // last label's price per column
   ArrayResize(taken, ncols);
   for(int c = 0; c < ncols; c++)
      taken[c] = g_lv_price[idx[0]] + span + 1.0;   // nothing placed yet

   int drawn = 0;
   for(int i = 0; i < n; i++)
     {
      int j = idx[i];
      double price = g_lv_price[j];

      int col = -1;
      for(int c = 0; c < ncols; c++)
         if((taken[c] - price) >= gap)
           {
            col = c;
            break;
           }
      if(col < 0)                           // every column is crowded here
        {
         col = 0;
         double best = taken[0] - price;
         for(int c = 1; c < ncols; c++)
            if((taken[c] - price) > best)
              {
               best = taken[c] - price;
               col = c;
              }
        }
      taken[col] = price;

      if(DrawLevel(g_lv_id[j], g_lv_label[j], g_lv_short[j], price,
                   g_lv_col[j], g_lv_style[j], g_lv_width[j], col))
         drawn++;
     }
   return(drawn);
  }

//+------------------------------------------------------------------+
//| Decide whether a level is shown, and how it looks.               |
//+------------------------------------------------------------------+
bool Wanted(const string kind, const int cov, color &clr, int &style, int &width)
  {
   if(kind == "box_high" || kind == "box_low")
     {
      bool on = (cov == 50 && InpShowBox50) || (cov == 70 && InpShowBox70)
                || (cov == 80 && InpShowBox80) || (cov == 90 && InpShowBox90);
      if(!on)
         return(false);
      clr   = InpColBox;
      style = (cov == 80) ? STYLE_SOLID : STYLE_DOT;
      width = (cov == 80) ? 2 : 1;
      return(true);
     }
   if(kind == "cond_high" || kind == "cond_low")
     {
      bool on = (cov == 80 && InpShowCond80) || (cov == 50 && InpShowCond50);
      if(!on)
         return(false);
      clr   = InpColCond;
      style = STYLE_DASH;
      width = 1;
      return(true);
     }
   if(kind == "prev_high" || kind == "prev_low")
     {
      if(!InpShowPrevHL)
         return(false);
      clr = InpColPrev;
      style = STYLE_SOLID;
      width = 1;
      return(true);
     }
   if(kind == "prev_close")
     {
      if(!InpShowPrevClose)
         return(false);
      clr = InpColClose;
      style = STYLE_DASHDOT;
      width = 1;
      return(true);
     }
   if(kind == "pivot")
     {
      clr = InpColPivot;
      style = STYLE_DOT;
      width = 1;
      return(InpShowPivot || InpShowPivotOuter);  // narrowed below by label
     }
   if(kind == "swing_high" || kind == "swing_low")
     {
      if(!InpShowSwing)
         return(false);
      clr = InpColSwing;
      style = STYLE_DOT;
      width = 1;
      return(true);
     }
   return(false);
  }

//+------------------------------------------------------------------+
bool DrawLevel(const string id, const string label, const string shortLabel,
               const double price, const color clr, const int style,
               const int width, const int column)
  {
   string lname = PREFIX + "L_" + id + "_" + label;
   string tname = PREFIX + "T_" + id + "_" + label + "#" + IntegerToString(column);

   if(!ObjectCreate(0, lname, OBJ_HLINE, 0, 0, price))
      return(false);
   ObjectSetInteger(0, lname, OBJPROP_COLOR, clr);
   ObjectSetInteger(0, lname, OBJPROP_STYLE, style);
   ObjectSetInteger(0, lname, OBJPROP_WIDTH, width);
   ObjectSetInteger(0, lname, OBJPROP_BACK, true);
   ObjectSetInteger(0, lname, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, lname, OBJPROP_HIDDEN, true);
   ObjectSetString(0, lname, OBJPROP_TEXT, label);

   string text = (InpShortLabels ? shortLabel : label)
                 + "  " + DoubleToString(price, Digits);
   if(ObjectCreate(0, tname, OBJ_TEXT, 0, LabelTime(column), price))
     {
      ObjectSetString(0, tname, OBJPROP_TEXT, text);
      ObjectSetString(0, tname, OBJPROP_FONT, "Arial");
      ObjectSetInteger(0, tname, OBJPROP_FONTSIZE, InpFontSize);
      ObjectSetInteger(0, tname, OBJPROP_COLOR, clr);
      // sit the text just above the line rather than across it
      ObjectSetInteger(0, tname, OBJPROP_ANCHOR, ANCHOR_LEFT_LOWER);
      ObjectSetInteger(0, tname, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);
      ObjectSetInteger(0, tname, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, tname, OBJPROP_HIDDEN, true);
     }
   return(true);
  }

//+------------------------------------------------------------------+
datetime LabelTime(const int column = 0)
  {
   int shift = InpLabelShiftBars;
   if(shift < 0)
      shift = 0;
   shift += column * InpLabelColumnBars;
   return(Time[0] + (datetime)(shift * PeriodSeconds()));
  }

//+------------------------------------------------------------------+
//| Keep the labels beside the newest bar as new bars form.          |
//+------------------------------------------------------------------+
void ShiftLabels()
  {
   int total = ObjectsTotal(0, -1, OBJ_TEXT);
   for(int i = total - 1; i >= 0; i--)
     {
      string name = ObjectName(0, i, -1, OBJ_TEXT);
      if(StringFind(name, PREFIX + "T_") != 0)
         continue;
      int h = StringFind(name, "#");
      int col = (h >= 0) ? (int)StringToInteger(StringSubstr(name, h + 1)) : 0;
      ObjectSetInteger(0, name, OBJPROP_TIME, 0, LabelTime(col));
     }
   ChartRedraw();
  }

//+------------------------------------------------------------------+
string Info(const string key)
  {
   for(int i = 0; i < ArraySize(g_info_keys); i++)
      if(g_info_keys[i] == key)
         return(g_info_vals[i]);
   return("");
  }

//+------------------------------------------------------------------+
void Status()
  {
   if(!InpShowStatus)
     {
      Comment("");
      return;
     }
   string s = "XAU/USD range forecast  [" + g_conv + "]";
   string broker = Info("broker");
   if(broker != "")
      s += "  " + broker;
   s += "\n" + g_status;
   if(g_last_ok > 0)
      s += "   updated " + TimeToString(g_last_ok, TIME_MINUTES);

   string sj = Info("session_jst");
   if(sj != "")
      s += "\nsession " + sj;
   if(Info("prev_close") != "")
      s += "\nprev close " + Info("prev_close")
           + "   sigma " + Info("sigma")
           + "   ATR14 " + Info("atr14");
   if(Info("range_median") != "")
      s += "\nexpected range (median) " + Info("range_median");
   if(Info("realized_range") != "")
      s += "\nrealized " + Info("realized_low") + " - " + Info("realized_high")
           + "  (" + Info("realized_range") + ", "
           + Info("elapsed_hours") + "h elapsed)";
   if(Info("p_high_set") != "")
      s += "\nhigh already set " + Info("p_high_set") + "%"
           + "   low already set " + Info("p_low_set") + "%";
   s += "\nQuantitative analysis, not investment advice. This EA places no orders.";
   Comment(s);
  }
//+------------------------------------------------------------------+
